[Unit]
Description=Prokachka Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/prokachka-start
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027

[Install]
WantedBy=multi-user.target
